# 복사해서 .env 로 사용 (.env 는 git 에 올라가지 않습니다)
# 배포 주소: 공유하기·링크 복사·OG 미리보기에 사용. 비워 두면 GitHub Actions 에서 자동 계산(https://<owner>.github.io/<repo>/)
SITE_URL=https://suhyeon-joo.github.io/ourwedding/
# 참석 의사·방명록 전송 주소: scripts/apps-script/README.md 의 Apps Script 웹앱 URL
# 비워 두면 폼 제출 버튼이 비활성화되고 "준비 중" 안내만 표시
RSVP_FORM_URL=
# 개인정보 (GitHub 저장소 Settings → Variables 에도 같은 이름으로 등록). 값은 빌드 시 index.html 의 {{KEY}} 자리에 들어갑니다.
GROOM_NAME=
BRIDE_NAME=
GROOM_FATHER_NAME=
GROOM_MOTHER_NAME=
BRIDE_FATHER_NAME=
BRIDE_MOTHER_NAME=
GROOM_PHONE=
BRIDE_PHONE=
GROOM_ACCOUNT=
BRIDE_ACCOUNT=
GROOM_FATHER_ACCOUNT=
GROOM_MOTHER_ACCOUNT=
BRIDE_FATHER_ACCOUNT=
BRIDE_MOTHER_ACCOUNT=
